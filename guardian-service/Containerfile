# AI-assisted: Claude Code / Claude Opus 5.5 (claude-opus-5-5)

# Battery Thermal Guardian. Build from the repository root:
#   docker build -f guardian-service/Containerfile .

FROM docker.io/library/rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p guardian-service --bin guardian \
    && cp target/release/guardian /usr/local/bin/guardian

FROM docker.io/library/debian:bookworm-slim
COPY --from=build /usr/local/bin/guardian /usr/local/bin/guardian
COPY config/guardian/safety-params.toml /etc/guardian/safety-params.toml
ENV GUARDIAN_CONFIG=/etc/guardian/safety-params.toml
ENTRYPOINT ["/usr/local/bin/guardian"]
