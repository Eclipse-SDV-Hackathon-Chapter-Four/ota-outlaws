# AI-assisted: Codex / GPT-6.1 Sol (gpt-6.1-sol)

# Compile exclusively from a Git archive generated by build-images.sh.
FROM ghcr.io/eclipse-score/devcontainer:1.0.0@sha256:aa05bf9b8b1636b45cae340e0a7789ad099d5467ddc2570cd265d5a83144a0f8 AS build
USER root
RUN apt-get update && apt-get install -y --no-install-recommends cmake pkg-config libssl-dev libclang-dev clang protobuf-compiler && rm -rf /var/lib/apt/lists/*
RUN rustup toolchain install nightly-2026-05-07 --profile minimal
ENV RUSTUP_TOOLCHAIN=nightly-2026-05-07 CARGO_BUILD_JOBS=4 CARGO_TARGET_DIR=/build/target
WORKDIR /build/demo
COPY demo /build/demo
RUN cd fault-lib && cargo build --locked --bin dfm_bin
RUN cd opensovd-core && cargo build --locked -p opensovd-gateway --features fault-lib
# Example test tools are built from the same committed source snapshot.
RUN cargo build --locked -p dr-whodunit-services --bin guardian --bin fault_injector
RUN mkdir /binaries && cp /build/target/debug/dfm_bin /build/target/debug/opensovd-gateway /build/target/debug/guardian /build/target/debug/fault_injector /binaries/ && strip /binaries/*

FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libssl3t64 && rm -rf /var/lib/apt/lists/*
COPY --from=build /binaries/ /usr/local/bin/
COPY source-files.txt /usr/share/opensovd/source-files.txt
ARG SOURCE_REV
LABEL org.opencontainers.image.source="https://github.com/Eclipse-SDV-Hackathon-Chapter-Four/Doctor-Whodunit" \
      org.opencontainers.image.revision="$SOURCE_REV" \
      org.opencontainers.image.title="OpenSOVD demo fork with DFM and example test tools"
ENV RUST_LOG=info
