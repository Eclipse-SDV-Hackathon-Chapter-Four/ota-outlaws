# AI-assisted: Claude Code / Claude Opus 5.5 (claude-opus-5-5)

# VSS Publisher. Build from the repository root, because it uses contracts/:
#   docker build -f vss-publisher/Containerfile .

FROM docker.io/library/rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/vss-publisher/target \
    cargo build --release --locked --manifest-path vss-publisher/Cargo.toml --bin vss-publisher \
    && cp vss-publisher/target/release/vss-publisher /usr/local/bin/vss-publisher

FROM docker.io/library/debian:bookworm-slim
COPY --from=build /usr/local/bin/vss-publisher /usr/local/bin/vss-publisher
ENTRYPOINT ["/usr/local/bin/vss-publisher"]
