# Installed as /usr/local/bin/cannelloni inside each guest; EDGAR calls it.
# Preserve EDGAR's server/client/interface arguments, translating only transport.
# cannelloni.real is the locally built TCP-compatible executable. Both peers
# need this wrapper because one SCTP endpoint cannot talk to a TCP endpoint.
set -euo pipefail
# AutoSD's current automotive kernel has no SCTP. Both ends must use TCP.
args=()
for arg in "$@"; do
    if [[ "$arg" == '-S' ]]; then arg='-C'; fi
    args+=("$arg")
done
exec /usr/local/bin/cannelloni.real "${args[@]}"
