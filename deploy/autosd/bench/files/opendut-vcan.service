# Installed in the AutoSD image: create vcan0 once during boot.
# Leaving an existing interface in place makes repeated starts safe.
[Unit]
Description=Create virtual CAN interface for openDuT
After=systemd-modules-load.service
Before=opendut-edgar.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash -ec 'if ! ip link show vcan0 >/dev/null 2>&1; then ip link add dev vcan0 type vcan; fi; ip link set dev vcan0 up'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
