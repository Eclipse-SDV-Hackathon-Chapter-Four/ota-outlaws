FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends cmake g++ make patch && rm -rf /var/lib/apt/lists/*
COPY source /source
COPY tcp-read.patch /tmp/tcp-read.patch
RUN cd /source && patch -p1 < /tmp/tcp-read.patch && \
    cmake -S /source -B /build -DSCTP_SUPPORT=OFF -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /build --parallel 2
