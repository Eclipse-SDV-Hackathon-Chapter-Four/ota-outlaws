[Unit]
Description=OTA Outlaws local Ankaios server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/ota-ankaios-1.0.4/ank-server --insecure --address 127.0.0.1:25551 --startup-manifest /opt/ota-outlaws-autosd/ankaios-state.yaml
Restart=on-failure

[Install]
WantedBy=multi-user.target
